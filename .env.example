# Copy this to .env and fill in your values
# cp .env.example .env
# Or generate one at https://ha.ci.computer

# ── Required ──────────────────────────────────────────────────────────────────
# ci-server API key (shared secret between the voice bridge and ci-server).
# ci-server enforces this in every environment - when it is unset, every /v1
# request is refused with 503 auth_not_configured.
# Generate one with: openssl rand -hex 32
MASTER_API_KEY=change-me-in-production

# PostgreSQL password for the bundled database
POSTGRES_PASSWORD=change-me-in-production

# JWT secret for session tokens
JWT_SECRET=change-me-in-production

# ── Language model ────────────────────────────────────────────────────────────
# Prefix with "ollama:" for Ollama, "openai:" for OpenAI, "vllm:" for vLLM.
# Pull it first: docker compose exec ollama ollama pull llama3.2
CI_MODEL=ollama:llama3.2

# Point at another OpenAI-compatible LLM endpoint instead of the bundled Ollama,
# for example Companion Hub's inference pool: http://ci-hub:5002/api/inference/pool
# OLLAMA_BASE_URL=

# Optional: vLLM server URL
VLLM_BASE_URL=

# ── Speech-to-text and text-to-speech ─────────────────────────────────────────
# Any OpenAI-compatible speech server. With `docker compose --profile local-audio up`
# the bundled speaches container provides both:
# STT_BASE_URL=http://speaches:8000
# STT_MODEL=Systran/faster-distil-whisper-small.en
# TTS_BASE_URL=http://speaches:8000
# TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# CI_TTS_VOICE=af_heart
# CI_TTS_VOICES=af_heart,af_bella,am_adam
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Optional: OpenAI API key, used for Whisper STT / TTS / openai: models when no
# local speech server is configured.
OPENAI_API_KEY=

# Voice the bridge asks for, and the voices it offers Home Assistant.
CI_TTS_VOICE=alloy
CI_TTS_VOICES=
LANGUAGES=en

# ── Companion Memory (CI-Server) ──────────────────────────────────────────────
# Ground answers in your Companion Memory and save each voice exchange to it.
# Create a key in Companion Memory > Settings > API keys with the `memory`
# scope. Include /api when going through the Companion Memory gateway.
# CI_MEMORY_URL=https://memory.example.com/api
CI_MEMORY_URL=
CI_MEMORY_API_KEY=
CI_MEMORY_RECALL=true
CI_MEMORY_SAVE_TURNS=true

# ── Misc ──────────────────────────────────────────────────────────────────────
# CORS allowed origins (comma-separated, or * for all). The setup checker at
# https://ha.ci.computer needs to be allowed if you use it.
CORS_ORIGINS=*

# Advertise the bridge to Home Assistant over mDNS (needs host networking).
WYOMING_ZEROCONF=false
