# Copy this to .env and fill in your values
# cp .env.example .env

# ci-server API key (shared secret between HA/voice-bridge and ci-server)
MASTER_API_KEY=change-me-in-production

# JWT secret for session tokens
JWT_SECRET=change-me-in-production

# Optional: OpenAI API key for Whisper STT / GPT fallback / TTS
OPENAI_API_KEY=

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# LLM model to use (prefix with "ollama:" for Ollama, "openai:" for OpenAI)
CI_MODEL=ollama:llama2

# Optional: vLLM server URL
VLLM_BASE_URL=
